# Binaries.
# Anchored with a leading slash: a bare "lancastd" also matches the
# cmd/lancastd/ source directory and silently excludes the entrypoint.
/lancastd
/lancastd.exe
/lancast.exe
/LANcast-Server
/LANcast-Server.exe
/LANcast-Client
/LANcast-Client.exe
/dist/
# Editor and build backups of the above. The anchored names miss these,
# and a 30 MB LANcast-Server.exe~ once reached main because of it.
*.exe~
*.exe.bak

# Installer build artifacts: the exes copied in from the release build and the
# generated setup.exe. The .nsi script and welcome.bmp are committed source.
installer/*.exe

# Local state — never commit a library database
*.db
*.db-shm
*.db-wal
/data/

# Plugin signing key material — the private key must NEVER be committed
# (ADR 0021). Only the public half belongs in the repo, embedded in
# internal/plugin/projectkey.go. Built bundles are release artifacts, not source.
*.key
*.lcplugin

# Web client build output
/web/dist/
/web/node_modules/
node_modules/

# Editor and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Test fixtures may contain real media; keep generated ones out
/testdata/generated/

# Autonomous-session work logs. Kept on disk, not in the repo.
/AUTO-AGENT TEST LOG/

# Local run configuration for the preview tooling. Machine-specific: it names
# a data directory that exists on one computer.
.claude/launch.json
