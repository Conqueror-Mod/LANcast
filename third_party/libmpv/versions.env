# The exact sources LANcast's libmpv is built from (ADR 0069).
#
# Pinned by tag, never by branch: a build that tracks a branch is a build
# nobody can reproduce, and the hash in PROVENANCE.md would mean nothing.
#
# Every one of these is LGPL, BSD, MIT or Apache-2.0. Nothing GPL is fetched,
# which is the property the whole recipe exists to keep — see build.sh for the
# configure flags that hold the line on FFmpeg and mpv themselves.

ZLIB_TAG=v1.3.1          # zlib licence — Matroska header compression
DAV1D_TAG=1.5.4          # BSD-2 — AV1 decoding
SPIRV_CROSS_TAG=vulkan-sdk-1.4.357.0  # Apache-2.0 — shader translation for D3D11
SHADERC_TAG=v2026.4      # Apache-2.0 — GLSL to SPIR-V, for libplacebo's D3D11 path
LIBPLACEBO_TAG=v7.360.1  # LGPL-2.1+ — mpv's renderer: scaling, HDR tone mapping
FFMPEG_TAG=n9.0.2        # LGPL-2.1+ as configured here (no --enable-gpl)
FREETYPE_TAG=VER-2-14-3 # FTL (BSD-like) — glyph rasterising for libass
FRIBIDI_TAG=v1.0.16      # LGPL-2.1+ — bidirectional text
HARFBUZZ_TAG=14.4.0      # MIT — text shaping
LIBASS_TAG=0.17.5        # ISC — subtitle rendering; mpv 0.41 requires it

MPV_TAG=v0.41.0          # LGPL-2.1+ as configured here (-Dgpl=false)
