# The published libmpv-2.dll this release ships (ADR 0069).
#
# Updated in the same commit that adds a row to PROVENANCE.md. fetch.sh refuses
# a download whose hash does not match, so these two lines are what stands
# between the installer and somebody else's DLL.
#
# Empty until the first build is published; fetch.sh then fails loudly rather
# than silently shipping an installer without a player.

LIBMPV_URL=
LIBMPV_SHA256=
