# The exact sources LANcast's rcheevos.dll is built from (ADR 0112).
#
# Pinned by tag and commit, never by branch, for the reason libmpv's are
# (ADR 0069): a build that tracks a branch is a build nobody can reproduce.
# Both are MIT.

RCHEEVOS_TAG=v12.5.0
RCHEEVOS_COMMIT=1433173220a7eaede6a9ed7a18e94117be1821e0

# libretro.h only, for rc_libretro's memory maps. One header, from
# libretro-common at a fixed commit.
LIBRETRO_COMMON_COMMIT=d9597c359a5ca8399a4e244f816e7e975a92a2aa
