<?xml version="1.0" encoding="utf-8" ?>
<!-- One episode: its picture, its title, and a neutral line under it. -->
<component name="EpisodeRow" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="show" />
    <field id="width" type="float" />
    <field id="height" type="float" />
    <field id="focusPercent" type="float" onChange="paint" />
    <field id="listHasFocus" type="boolean" onChange="paint" />
  </interface>
  <script type="text/brightscript" uri="EpisodeRow.brs" />
  <children>
    <Rectangle id="halo" translation="[-8,-8]" width="1396" height="136" color="0xC6A35AFF" opacity="0" />
    <Rectangle id="ring" width="1380" height="120" color="0xC6A35AFF" opacity="0.2" />
    <Rectangle translation="[3,3]" width="1374" height="114" color="0x0A0F22FF" />
    <Rectangle translation="[12,10]" width="178" height="100" color="0x141B33FF" />
    <Poster id="thumb" translation="[12,10]" width="178" height="100" loadDisplayMode="scaleToZoom" loadWidth="178" loadHeight="100" />
    <Label id="title" translation="[214,18]" width="1140" color="0xC3CBE2FF" font="font:MediumBoldSystemFont" />
    <Label id="sub" translation="[214,68]" width="1140" color="0x8F99B5FF" font="font:SmallSystemFont" />
  </children>
</component>
