<?xml version="1.0" encoding="utf-8" ?>
<!--
  The code this TV computed, large, and where to type it. Gold appears only on
  the focused button: the code itself is information, not a place you are.
-->
<component name="PairScreen" extends="Group">
  <interface>
    <field id="server" type="string" onChange="showWhere" />
    <field id="code" type="string" onChange="showCode" />
    <field id="message" type="string" onChange="showMessage" />
    <field id="newCode" type="boolean" alwaysNotify="true" />
    <field id="changeServer" type="boolean" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/pairing.brs" />
  <script type="text/brightscript" uri="PairScreen.brs" />
  <children>
    <Label translation="[160,150]" width="1600" color="0xF2F5FBFF" font="font:LargeBoldSystemFont" text="Pair this TV" />
    <Label id="where" translation="[160,250]" width="1500" wrap="true" color="0xC3CBE2FF" font="font:MediumSystemFont" />
    <Label id="code" translation="[160,380]" width="1600" color="0xF2F5FBFF" text="…">
      <Font role="font" uri="font:BoldSystemFontFile" size="120" />
    </Label>
    <Label id="status" translation="[160,560]" width="1500" wrap="true" color="0xF2F5FBFF" font="font:MediumSystemFont" text="Asking the server for a code…" />
    <FocusButton id="again" translation="[160,760]" width="460" text="Get a new code" />
    <FocusButton id="change" translation="[660,760]" width="460" text="Change server" />
  </children>
</component>
