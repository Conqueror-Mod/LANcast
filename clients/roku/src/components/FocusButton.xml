<?xml version="1.0" encoding="utf-8" ?>
<!--
  A button that shows where you are, and nothing else, in gold (design.md: gold
  is earned, not ambient). At rest the edge is gold at 20%; focused it is full
  gold with a soft 13% halo. Nothing else on screen is gold while it is.
-->
<component name="FocusButton" extends="Group">
  <interface>
    <field id="text" type="string" onChange="layout" />
    <field id="width" type="float" value="420" onChange="layout" />
    <field id="height" type="float" value="88" onChange="layout" />
    <field id="selected" type="boolean" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="FocusButton.brs" />
  <children>
    <Rectangle id="halo" color="0xC6A35AFF" opacity="0" />
    <Rectangle id="ring" color="0xC6A35AFF" opacity="0.2" />
    <Rectangle id="fill" color="0x0A0F22FF" />
    <Label id="label" color="0xC3CBE2FF" horizAlign="center" vertAlign="center" font="font:MediumSystemFont" />
  </children>
</component>
