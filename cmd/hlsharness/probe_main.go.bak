package main

import (
	"fmt"

	"golang.org/x/sys/windows/svc/mgr"
)

func main() {
	m, err := mgr.Connect()
	if err != nil {
		fmt.Println("mgr.Connect FAILED:", err)
		return
	}
	defer m.Disconnect()
	s, err := m.OpenService("lancastd")
	if err != nil {
		fmt.Println("OpenService FAILED:", err)
		return
	}
	defer s.Close()
	st, err := s.Query()
	if err != nil {
		fmt.Println("Query FAILED:", err)
		return
	}
	fmt.Println("OK state:", st.State)
}
